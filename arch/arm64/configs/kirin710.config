# SPDX-License-Identifier: GPL-2.0-only
# CONFIG_ARM64_VA_BITS_39 is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_SPMI_HISI3670=y
CONFIG_REGULATOR_KIRIN710_UFS=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_HISI=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
CONFIG_HWSPINLOCK_HISI=y
CONFIG_COMMON_CLK_KIRIN710_USB=y
CONFIG_USB_DWC3_KIRIN710=y
CONFIG_MAILBOX=y
CONFIG_HI3660_MBOX=y
CONFIG_HWSPINLOCK=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_EFI is not set
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_ARM_SP805_WATCHDOG=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_KIRIN710_TRUSTCORE=y
# CONFIG_USB_G_SERIAL is not set
# CONFIG_ARM64_ERRATUM_858921 is not set
# CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_PANFROST=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_SPI_PL022=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_POWER_SUPPLY=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_LOCALVERSION="-marie"
CONFIG_CMDLINE="console=ttynull log_buf_len=1M nokaslr kvm-arm.mode=none"
# CONFIG_JUMP_LABEL is not set
# CONFIG_BPF_JIT_ALWAYS_ON is not set
# CONFIG_RUST is not set
# CONFIG_ASHMEM is not set
# CONFIG_GENDWARFKSYMS is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_HIBERNATION is not set
# CONFIG_AUTOFDO_CLANG is not set

# Kirin 710 GPIO, pinmux, DW-MMC SDIO, and Hi1102 Wi-Fi (Phase 1)
CONFIG_GPIO_PL061=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_K3=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_HI1102_WIFI=y
CONFIG_HOTPLUG_CPU=y
CONFIG_EFI=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_SND_SOC_MARIE=y
